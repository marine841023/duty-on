{
  "name": "trae-pet",
  "version": "1.0.0",
  "description": "Live2D desktop pet for monitoring Trae IDE AI task status",
  "main": "src/main/index.js",
  "author": "Trae Pet",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "postinstall": "node scripts/download-assets.js",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:dir": "electron-builder --win --dir",
    "publish": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^7.4.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8",
    "jest": "^30.4.2"
  },
  "build": {
    "appId": "com.traepet.desktop",
    "productName": "TraePet",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "hooks/**/*",
      "node_modules/**/*",
      "package.json",
      "!**/*.{md,markdown,map}",
      "!**/.{git,gitignore,DS_Store}",
      "!release/**",
      "!build/**",
      "!scripts/**",
      "!node_modules/@pixi/**",
      "!node_modules/pixi.js/{src,lib,cjs,test,tests,types}/**",
      "!node_modules/pixi.js/dist/{browser,cjs,esm}/**",
      "!node_modules/pixi.js/node_modules/**",
      "!node_modules/pixi-live2d-display/{src,lib,test,tests,types}/**"
    ],
    "electronLanguages": [
      "zh-CN",
      "zh-TW",
      "en-US",
      "ja",
      "ko-KR"
    ],
    "extraResources": [
      {
        "from": "hooks",
        "to": "hooks"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "TraePet-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "TraePet-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["zh-CN", "zh-TW", "en-US", "ja", "ko-KR"],
      "include": "build/installer.nsh",
      "artifactName": "TraePet-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "generic",
      "url": "http://127.0.0.1:17522/updates"
    }
  }
}
