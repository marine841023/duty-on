# C++ build output (device)
device/build/
# 交叉编译输出（Windows 宿主 → aarch64；同上，构建产物不入库）
device/build-cross/
# 交叉编译 sysroot（从设备拉回的 EGL/GBM/DRM 头文件与 .so，含专有库）及
# 传输归档 —— 设备特定，不入库；重建方法见 device/cmake/aarch64-toolchain.cmake 注释
device/sysroot/
device/sysroot*.tgz

# Manually downloaded third-party SDK (see device/README.md)
# - CubismNativeSdk: Live2D 许可禁止再分发
# - deps/stb: 构建期下载的依赖源码
device/third_party/

# Logs
*.log

# IDE / Editor
.vscode/
.idea/
*.swp
Thumbs.db

# Trae workspace docs
.trae/

# Local OS / misc
.DS_Store
*.psd

# Scratch files from debugging sessions
*.tmp
# ImGui runtime window-layout dump
imgui.ini

# .userdata: 设备部署/构建脚本随库共享（供后继开发者）；真实凭据与抓帧快照不入库
# 脚本从环境变量或同目录 deploy.env 读取设备 SSH 凭据，模板见 deploy.env.example
.userdata/deploy.env
.userdata/*.bmp
.userdata/*.png
# 会话临时探针/调试脚本（约定 `_` 前缀），不入库以防误提交凭据
.userdata/_*
# gen_voice_prompts.py 的生成产物目录；入库的正式副本在 frontend/assets/device/sounds/
.userdata/sounds/
# 本地调试/诊断/一次性脚本与临时草稿（设备排查期间产生，不入库）。注意：
# gitignore 对已跟踪文件无效——上面列出的部署/构建脚本仍随库共享，不受影响；
# 确需共享新脚本时用 git add -f 强制添加
.userdata/*
# 离线安装的设备 deb 包与本地依赖源码克隆（交叉编译/配网工具准备期产物）
.userdata/*.deb
.userdata/deps-src/

# 2.0 packaging toolchain & output (NSIS portable auto-downloaded)
tools/nsis/
tools/dist/
tools/*.png
tools/*.ico
# Arm GNU 交叉编译工具链（13.2.Rel1，~2GB，许可允许再分发但体积过大）
# 下载放置方法见 device/cmake/aarch64-toolchain.cmake 注释
tools/cross/

# Local release artifacts (installers built during cross-branch releases)
release/

# 云服务器：Go 编译产物与运行时数据（用户/令牌/上传文件/更新包）
server/dutyon-cloud
server/data/

# 语音识别资产：大模型与引擎二进制不入库（239MB/22MB，随 .userdata/x-deploy.sh
# 分发到设备与 frontend/assets 正式副本以外的渠道）；小文件（pinyin/tokens/vad）入库
frontend/assets/device/kws/asr-offline
frontend/assets/device/kws/sense-voice/model.int8.onnx
