# DutyOn 设备部署凭据模板
#
# 用法：复制为同目录的 deploy.env（已被 .gitignore 忽略，不会入库），填入真实值：
#   cp .userdata/deploy.env.example .userdata/deploy.env
# sync-and-build.sh / wait-build.sh 启动时会自动 source 同目录的 deploy.env；
# 也可以不建 deploy.env，直接在 shell 里 export 下面这些变量。

# 设备 SSH 目标：WSL 侧经局域网 / usb0 访问香橙派（root 用户）
DUTYON_DEVICE=root@192.168.1.68

# 设备 SSH 口令（sshpass 使用）—— 只写进本地 deploy.env，切勿提交
DUTYON_DEVICE_PASS=your-device-ssh-password

# 可选：仓库根路径。默认由脚本按自身位置自动推断（WSL 下形如 /mnt/d/src/dutyOn）
# DUTYON_REPO=/mnt/d/src/dutyOn
