server {
    listen 80;
    server_name dutyon.megrezsoft.com;
    location ^~ /.well-known/acme-challenge/ { root /var/lib/letsencrypt; }
    location / { return 301 https://dutyon.megrezsoft.com$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name dutyon.megrezsoft.com;
    ssl_certificate /etc/letsencrypt/live/dutyon.megrezsoft.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dutyon.megrezsoft.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 51m;
    client_body_timeout 180s;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_request_buffering off;
        proxy_buffering off;
    }
}
