# CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o dutyon-cloud-linux .
FROM scratch
COPY --chown=10001:10001 runtime-data /data
COPY dutyon-cloud-linux /usr/local/bin/dutyon-cloud
USER 10001:10001
WORKDIR /data
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s \
    CMD ["/usr/local/bin/dutyon-cloud", "--healthcheck", "http://127.0.0.1:8787/healthz"]
ENTRYPOINT ["/usr/local/bin/dutyon-cloud"]
CMD ["--addr", ":8787", "--data", "/data"]
